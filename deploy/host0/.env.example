# REG.RU Host-0: copy to .env in the PRIVATE application directory.
APP_ENV=production
SITE_URL=https://dancesrevolution.ru
# Absolute path outside www. Empty uses dance-revolution/.data.
DATA_DIR=

# Fill using the MySQL 8 database settings in ispmanager.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Optional for saving applications; required for email notifications.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=dance@revolution-msk.ru
SMTP_PASSWORD=
SMTP_FROM=dance@revolution-msk.ru
