Options -Indexes
DirectoryIndex disabled

RewriteEngine On
# Keep certificate renewal reachable; redirect only the www alias.
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^www\.dancesrevolution\.ru(?::[0-9]+)?$ [NC]
RewriteRule ^ https://dancesrevolution.ru%{REQUEST_URI} [R=301,L,NE]

<FilesMatch "(^\.|\.py[co]?$|\.sqlite(?:-wal|-shm)?$|\.log$|\.ini$|\.env$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    # Vite JS/CSS filenames contain content hashes and change with every edit.
    <FilesMatch "\.(?:js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:webp|png|jpe?g|svg|mp4|pdf|docx)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
