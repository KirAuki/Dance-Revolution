{
  "name": "dance-revolution-2027",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/python.mjs -m backend.cli serve",
    "db:init": "node scripts/python.mjs -m backend.cli init-db",
    "db:import": "node scripts/python.mjs -m backend.cli import-sqlite",
    "admin:create": "node scripts/python.mjs -m backend.cli admin",
    "admin:password": "node scripts/python.mjs -m backend.cli admin --reset",
    "build": "vite build",
    "preview": "node scripts/python.mjs -m backend.cli serve",
    "test": "node scripts/python.mjs -m pytest tests/test_backend.py -q && node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "release": "npm run build && node scripts/python.mjs -m backend.package"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
