# Local development: Python + SQLite. MySQL is required for production.
APP_ENV=development
SITE_URL=
# Absolute path, outside the domain document root. Default: .data next to backend.
DATA_DIR=

# REG.RU: create a MySQL 8 database and user in ispmanager.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# For production set APP_ENV=production and SITE_URL=https://your-domain.ru
# SMTP credentials stay here, never in the admin interface or in Git.
# Submissions are saved even when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
